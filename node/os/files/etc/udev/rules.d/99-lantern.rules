# Stable device names so the manifests never chase ttyUSB/ttyACM numbering.
# Find your IDs:  udevadm info -a -n /dev/ttyACM0 | grep -E 'idVendor|idProduct|serial' | head
# Classic Arduino Uno (2341:0043 / 2341:0001) and the common clone (2a03:0043):
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0043", SYMLINK+="spectro", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0001", SYMLINK+="spectro", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="2a03", ATTRS{idProduct}=="0043", SYMLINK+="spectro", MODE="0666"
# XBee on an FTDI-based USB adapter (SparkFun Explorer / Digi dev board = 0403:6001 or 0403:6015).
# If you have two FTDI devices, pin by ATTRS{serial}=="..." instead.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", SYMLINK+="xbee", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", SYMLINK+="xbee", MODE="0666"
