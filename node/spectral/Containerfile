# Lantern spectral node service. Build on the aarch64 host:
#   podman build -t quay.io/<org>/lantern-spectral:0.1 node/spectral && podman push quay.io/<org>/lantern-spectral:0.1
# UBI9 Python so the SBOM/Lightwell story holds for the app image too, not only the OS.
FROM registry.access.redhat.com/ubi9/python-312:latest

USER 0
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && mkdir -p /var/telemetry && chown 1001:0 /var/telemetry
COPY app/ /app/
USER 1001
WORKDIR /app

ENV NODE_ID=spec-1 \
    SPECTRO_SOURCE=serial:///dev/spectro?baud=115200 \
    UPLINK=udp://127.0.0.1:5005 \
    TELEMETRY_DB=/var/telemetry/spectral.db \
    DARK_FILE=/var/telemetry/dark.npy \
    HTTP_PORT=8081
EXPOSE 8081
CMD ["python3", "/app/spectral.py"]
