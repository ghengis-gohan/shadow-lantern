# Lantern ground station. Build:
#   podman build -t quay.io/<org>/lantern-ground:0.1 ground && podman push quay.io/<org>/lantern-ground:0.1
# plotly is installed only so its bundled plotly.min.js can be served locally: demo venues have no internet.
FROM registry.access.redhat.com/ubi9/python-312:latest

USER 0
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && mkdir -p /var/telemetry && chown 1001:0 /var/telemetry
COPY app/ /app/
USER 1001
WORKDIR /app

ENV GS_UDP_PORT=5005 HTTP_PORT=8080 GS_DB=/var/telemetry/ground.db CORRELATION_WINDOW_S=10
EXPOSE 8080 5005/udp
CMD ["python3", "/app/gs.py"]
